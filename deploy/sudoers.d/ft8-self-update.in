# /etc/sudoers.d/ft8-self-update — rendered by deploy/install.sh
#
# Allows the appliance user a very small set of root operations for
# self-update, controller restart and system-file sync.

@APP_USER@ ALL=(root) NOPASSWD: \
    /bin/systemctl restart ft8-controller, \
    /bin/systemctl restart ft8-controller.service, \
    /bin/systemctl start ft8-controller, \
    /bin/systemctl start ft8-controller.service, \
    /bin/systemctl is-active ft8-controller, \
    /bin/systemctl is-active ft8-controller.service, \
    /bin/systemctl start ft8-self-update, \
    /bin/systemctl start ft8-self-update.service, \
    /bin/systemctl start --no-block ft8-self-update.service, \
    /bin/systemctl daemon-reload, \
    /bin/systemctl start ft8-ap-fallback, \
    /bin/systemctl start ft8-ap-fallback.service, \
    /bin/systemctl stop ft8-ap-fallback, \
    /bin/systemctl stop ft8-ap-fallback.service, \
    /bin/systemctl restart ft8-ap-fallback, \
    /bin/systemctl restart ft8-ap-fallback.service, \
    /bin/systemctl restart ft8-rigctld, \
    /bin/systemctl restart ft8-rigctld.service

@APP_USER@ ALL=(root) NOPASSWD: \
    /sbin/shutdown -h +0 *, \
    /sbin/shutdown -r +0 *

@APP_USER@ ALL=(root) NOPASSWD: \
    /usr/bin/install -m 644 @APP_DIR@/.deploy-rendered/systemd/ft8-controller.service /etc/systemd/system/ft8-controller.service, \
    /usr/bin/install -m 644 @APP_DIR@/.deploy-rendered/systemd/ft8-self-update.service /etc/systemd/system/ft8-self-update.service, \
    /usr/bin/install -m 644 @APP_DIR@/.deploy-rendered/systemd/ft8-self-update.timer /etc/systemd/system/ft8-self-update.timer, \
    /usr/bin/install -m 644 @APP_DIR@/.deploy-rendered/systemd/ft8-ap-fallback.service /etc/systemd/system/ft8-ap-fallback.service, \
    /usr/bin/install -m 644 @APP_DIR@/.deploy-rendered/systemd/ft8-rigctld.service /etc/systemd/system/ft8-rigctld.service, \
    /usr/bin/install -m 644 @APP_DIR@/deploy/systemd/ft8-hostapd.service /etc/systemd/system/ft8-hostapd.service, \
    /usr/bin/install -m 440 @APP_DIR@/.deploy-rendered/sudoers.d/ft8-self-update /etc/sudoers.d/ft8-self-update, \
    /usr/bin/install -m 644 @APP_DIR@/.deploy-rendered/ft8-rigctld.env /etc/default/ft8-rigctld, \
    /usr/bin/install -m 755 @APP_DIR@/deploy/scripts/ft8-wlan /usr/local/sbin/ft8-wlan

@APP_USER@ ALL=(root) NOPASSWD: /usr/sbin/visudo -c -f @APP_DIR@/.deploy-rendered/sudoers.d/ft8-self-update, /usr/sbin/visudo -c -f /etc/sudoers.d/ft8-self-update

# ---------------------------------------------------------------------------
# Dienstbenutzer des Controllers (SERVICE_USER, seit 2026-09-28). Unter ihm
# laeuft die Weboberflaeche. Er bekommt genau die Befehle, die die Oberflaeche
# ausloest — und KEINE install-/visudo-Regeln: System-Dateien schreibt nur
# der Self-Update-Lauf unter APP_USER. Ist SERVICE_USER gleich APP_USER,
# doppeln sich die Regeln nur.
@SERVICE_USER@ ALL=(root) NOPASSWD: \
    /bin/systemctl restart --no-block ft8-controller.service, \
    /bin/systemctl start --no-block ft8-self-update.service, \
    /bin/systemctl start ft8-ap-fallback.service, \
    /bin/systemctl stop ft8-ap-fallback.service, \
    /sbin/shutdown -h +0 *, \
    /sbin/shutdown -r +0 *

# WLAN-Profile aus der Oberflaeche (web/routes/network.py). Nur ueber das
# feste Hilfsskript: es kennt fuenf Aktionen und aendert nur WLAN-Profile.
# Bis 2026-11-28 stand hier "nmcli connection add|modify|delete|up *" — damit
# liess sich jede Verbindung mit beliebigen Eigenschaften umbauen.
@SERVICE_USER@ ALL=(root) NOPASSWD: \
    /usr/local/sbin/ft8-wlan rescan, \
    /usr/local/sbin/ft8-wlan add *, \
    /usr/local/sbin/ft8-wlan delete *, \
    /usr/local/sbin/ft8-wlan priority *, \
    /usr/local/sbin/ft8-wlan up *
