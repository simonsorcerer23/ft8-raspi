[Unit]
Description=FT8 Appliance hostapd (AP-Fallback WLAN)
Documentation=file:///home/sebastian/ft8-appliance/deploy/hostapd/ap.conf
# Eigene Unit statt Debians hostapd@.service (Audit 2026-09-06 A4): das
# Template bindet die Instanz per BindsTo=sys-subsystem-net-devices-%i.device
# an ein Netzgeraet MIT DEM INSTANZNAMEN. Unsere Instanz hiess "ft8-ap", ein
# Interface dieses Namens gibt es nicht — systemd startete hostapd und stoppte
# ihn 5 ms spaeter wieder ("Unnecessary job was removed for
# sys-subsystem-net-devices-ft8-ap.device"). Der AP kam nie hoch.
After=NetworkManager.service
# Nur ad hoc ueber ft8-ap-fallback.service, nie beim Boot.

[Service]
Type=simple
# /etc/hostapd/ft8-ap.conf ist seit 2026-09-28 nur noch die Vorlage mit
# Platzhalter-Passphrase. start-ap-fallback.sh erzeugt daraus mit den Werten
# der config.yaml /run/ft8-ap.conf. Fehlt die Datei, startet hostapd nicht —
# nie mit der Vorlage.
ExecStartPre=/usr/bin/test -s /run/ft8-ap.conf
ExecStart=/usr/sbin/hostapd /run/ft8-ap.conf
Restart=on-failure
RestartSec=3
