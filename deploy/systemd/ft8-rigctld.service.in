[Unit]
Description=Hamlib rigctld (configured from /etc/default/ft8-rigctld)
After=systemd-udev-settle.service
Wants=systemd-udev-settle.service
StartLimitIntervalSec=0

[Service]
Type=simple
# Dienstbenutzer, nicht APP_USER (seit 2026-09-28): Die Argumente kommen
# aus der config.yaml, die der Dienstbenutzer schreiben darf, und
# $RIG_PTT_ARGS wird unzitiert in Woerter geteilt. Lief rigctld als APP_USER
# (mit sudo), waere das ein Weg vom Dienstbenutzer zurueck zu root.
User=@SERVICE_USER@
Group=dialout

# RIG_MODEL / RIG_DEVICE / RIG_BAUD / RIG_PTT_ARGS are rendered from RigConfig
# (config.yaml). $RIG_PTT_ARGS steht absichtlich ohne Klammern: systemd teilt es
# dann in Woerter (--ptt-type=RTS --ptt-file=...); leer bei CAT-PTT.
# by ft8_appliance.rig.write_rigctld_envfile; see deploy/install.sh for the
# initial bootstrap. -T 127.0.0.1 binds loopback only.
EnvironmentFile=/etc/default/ft8-rigctld
# Der Waechter startet rigctld (RIGCTLD waehlt zwischen dem der Distribution
# und einem neueren unter /opt/hamlib; fehlt die Zeile, gilt /usr/bin/rigctld)
# und beendet es, sobald das Rig vom USB verschwindet — s. das Skript.
ExecStart=@APP_DIR@/deploy/scripts/rigctld-waechter.sh

# Restart=always (seit 2026-10-10): Wird das Rig ausgeschaltet, beendet sich
# rigctld mitunter sauber (02.10.2026: "Deactivated successfully") — und
# on-failure startete es dann nie wieder. Jetzt versucht systemd es alle zehn
# Sekunden, bis das Rig wieder da ist.
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
