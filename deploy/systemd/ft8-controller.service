[Unit]
Description=FT8 Raspi Appliance Controller
Documentation=file:///home/sebastian/ft8-appliance/architecture.md
# ft8-rigctld nur als Reihenfolge, nicht in Wants: Beim Stoppen (auch
# Herunterfahren) geht so erst der Controller und nimmt die PTT zurueck,
# solange rigctld noch antwortet. Ohne das stoppte systemd beide zugleich;
# am MK2-Pi (2026-11-12) war rigctld mitten im Senden 1 ms frueher weg und
# set_ptt(False) lief ins Leere.
After=network-online.target gpsd.service chrony.service ft8-rigctld.service
Wants=network-online.target gpsd.service chrony.service
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=notify
# Dienstbenutzer (SERVICE_USER in install.env, Vorgabe APP_USER). Auf der
# Station seit 2026-09-28 ein eigener Benutzer ohne sudo: Die Weboberflaeche
# laeuft hier, und wer sie uebernimmt, soll nicht root sein.
User=sebastian
Group=sebastian
WorkingDirectory=/home/sebastian/ft8-appliance/backend

Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=FT8_CONFIG=/etc/ft8-appliance/config.yaml

# Erst die Uhr, dann der Controller: Der Pi hat keine gepufferte Uhr und
# startet mit der Zeit vom letzten Herunterfahren. Am MK2-Pi (2026-11-13)
# lief der Controller zwei Sekunden vor dem Zeitabgleich an und schrieb
# Protokoll und Telemetrie mit einer 22 Stunden alten Uhrzeit. Gesendet
# wurde nicht, das sperrt der Zeit-Guard. Hoechstens 12 Versuche im
# 5-Sekunden-Takt; ohne Netz und ohne GPS startet er danach trotzdem.
ExecStartPre=-/usr/bin/chronyc waitsync 12 0.5 0 5
TimeoutStartSec=180

ExecStart=/home/sebastian/ft8-appliance/backend/.venv/bin/uvicorn \
    ft8_appliance.web.app:app \
    --host 0.0.0.0 \
    --port 8000 \
    --no-access-log

Restart=always
RestartSec=5

ProtectSystem=full
ProtectHome=false
ReadWritePaths=/var/lib/ft8-appliance /var/log/ft8-appliance /etc/ft8-appliance
PrivateTmp=true
# audio: USB-Soundkarte des Rigs; video: vcgencmd (Temperatur, Drosselung).
# Hier statt in /etc/group, damit ein Dienstbenutzer sie nicht dauerhaft traegt.
SupplementaryGroups=plugdev dialout netdev audio video

NotifyAccess=main
WatchdogSec=30

[Install]
WantedBy=multi-user.target
